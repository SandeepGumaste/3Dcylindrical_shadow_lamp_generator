# VITE_API_URL: origin of the backend API. Defaults to http://localhost:3001 for local development.
# In production use the site's own address (no trailing slash): vercel.json proxies /api/* to the backend, so the
# login cookie is same-site. Do not leave it empty (it falls back to localhost).
VITE_API_URL="http://localhost:3001"

# VITE_SITE_URL: Public origin of the deployed site (no trailing slash).
# Required for production builds; used for canonical URLs, sitemap.xml and robots.txt.
VITE_SITE_URL="MY_SITE_URL"
