# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: Public origin of the deployed site (no trailing slash).
# Required for production builds; used for canonical URLs, sitemap.xml and robots.txt.
VITE_SITE_URL="https://example.com"

# Login (Google OAuth) and users database. Local redirect URI to register in Google Cloud:
#   http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: OAuth client from Google Cloud Console.
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"
# AUTH_SECRET: random string that signs session cookies (e.g. `openssl rand -base64 32`).
AUTH_SECRET="MY_AUTH_SECRET"
# ADMIN_EMAIL: the verified Google email that gets role "admin"; everyone else is "user".
ADMIN_EMAIL="MY_ADMIN_EMAIL"
# MONGODB_URI: defaults to the local mongod; replace with the Atlas URL when you have it.
MONGODB_URI="mongodb://127.0.0.1:27017/odd-shadows"
# AUTH_URL: public origin of the site; local default shown.
AUTH_URL="http://localhost:3000"
