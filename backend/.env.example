# Google OAuth client (Google Cloud Console, Web application).
# Authorised redirect URI: <AUTH_URL>/api/auth/callback/google
#   local: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"
# Random string that signs session cookies (e.g. `openssl rand -base64 32`).
AUTH_SECRET="MY_AUTH_SECRET"
# The verified Google email that gets role "admin"; everyone else is "user".
ADMIN_EMAIL="MY_ADMIN_EMAIL"
# Defaults to the local mongod; replace with the Atlas connection string for production.
MONGODB_URI="mongodb://127.0.0.1:27017/odd-shadows"
# Public origin of this API, and of the frontend that may call it (CORS and post-login redirects).
AUTH_URL="http://localhost:3001"
FRONTEND_ORIGIN="http://localhost:3000"
# Port to listen on (Cloud Run sets this itself).
PORT=3001
