{
  "name": "odd-shadows-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "build": "esbuild src/server/main.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/main.js && cp -R assets dist/assets",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "cdt2d": "^1.0.0",
    "dotenv": "^17.2.3",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
